# =============================================================================
# Delego — Environment Configuration
# Copy to .env and adjust values for local development.
# =============================================================================

# --- General ---
NODE_ENV=development
LOG_LEVEL=debug

# --- API Gateway ---
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
# GATEWAY_API_V1_JSON_BODY_LIMIT=100kb
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
# Sentry error tracking — leave SENTRY_DSN empty to disable Sentry entirely.
# Never commit a real DSN.
SENTRY_DSN=
# Defaults to NODE_ENV when empty.
SENTRY_ENVIRONMENT=
# Fraction of requests traced for performance, 0–1 (default 0 = errors only).
SENTRY_TRACES_SAMPLE_RATE=0

# --- Frontend Apps ---
WEB_PORT=3001
MERCHANT_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Services (internal) ---
ORCHESTRATOR_URL=http://localhost:3010
AGENTS_URL=http://localhost:3011
WALLET_URL=http://localhost:3012
CATALOG_URL=http://localhost:3013
PAYMENTS_URL=http://localhost:3014
NOTIFICATIONS_URL=http://localhost:3015
ANALYTICS_URL=http://localhost:3016

# --- Internal service authentication (never commit real tokens) ---
ORCHESTRATOR_PAYMENTS_SERVICE_TOKEN=
PAYMENTS_WALLET_SERVICE_TOKEN=

# --- PostgreSQL ---
DATABASE_URL=postgresql://delego:delego@localhost:5432/delego
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Redis Cluster (packages/cache) ---
# Comma-separated seed nodes. Two or more switches the cache client into
# ioredis cluster mode; a single entry stays on a standalone connection.
# The client discovers the real topology (replicas, post-failover role
# changes) via CLUSTER SLOTS, so seeds need not be exhaustive.
REDIS_CLUSTER_NODES=localhost:6379
# Comma-separated read-replica seeds. Used for reporting only — ioredis
# discovers the live replica set itself.
#REDIS_CLUSTER_REPLICA_NODES=10.0.1.11:6379,10.0.1.12:6379,10.0.1.13:6379
# Set false to send reads to the master as well (scaleReads: 'master').
REDIS_ENABLE_READ_ONLY_REPLICAS=true
REDIS_MAX_REDIRECTIONS=16
REDIS_ENABLE_OFFLINE_QUEUE=true
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000
# Health-check pings: interval, per-ping timeout, and consecutive failures
# before a node is treated as unhealthy and reconnected.
REDIS_HEALTH_CHECK_INTERVAL_MS=5000
REDIS_HEALTH_CHECK_TIMEOUT_MS=2000
REDIS_HEALTH_CHECK_FAILURE_THRESHOLD=3
# How often ioredis refreshes its slot map via CLUSTER SLOTS.
REDIS_SLOTS_REFRESH_INTERVAL_MS=5000
# AUTH password, if the cluster requires one.
#REDIS_PASSWORD=

# --- Orchestrator distributed locks ---
# Unique per replica (Kubernetes sets this to the pod name).
# ORCHESTRATOR_INSTANCE_ID=orchestrator-local
# Set false to skip Redis locks (single-instance without Redis).
# ENABLE_DISTRIBUTED_LOCKS=true

# --- OpenTelemetry distributed tracing (Issue #370) ---
# Enable end-to-end tracing across gateway, orchestrator, payments and DB.
OTEL_ENABLED=true
# Logical service name reported in spans (override per app, e.g. delego-gateway).
OTEL_SERVICE_NAME=delego-gateway
# OTLP collector endpoint. Point at Jaeger (4318) or any OTLP-compatible collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Export protocol: http/protobuf | grpc
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Head sampling ratio for root spans (0.0 - 1.0).
OTEL_TRACES_SAMPLER_ARG=1.0
# Propagators used to carry trace context across HTTP and Redis stream envelopes.
OTEL_PROPAGATORS=tracecontext,baggage

# --- Stellar / Soroban ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_TIMEOUT_MS=30000
SOROBAN_RPC_MAX_RETRIES=3
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Soroban/Horizon RPC failover pool (Issue #527) ---
# Comma-separated list of 3+ Soroban RPC endpoints used for failover.
SOROBAN_RPC_POOL_URLS=https://soroban-testnet.stellar.org
SOROBAN_RPC_PING_INTERVAL_MS=15000
SOROBAN_RPC_FAILURE_THRESHOLD=1

# --- Fiat conversion oracle cache (Issue #528) ---
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
FIAT_ORACLE_CACHE_TTL_SECONDS=300
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Asset management (Issue #108)
# TTL for cached SEP-1 token metadata in seconds (default: 3600)
ASSET_METADATA_CACHE_TTL_SECONDS=3600
# Interval between real-time balance poll cycles in seconds (default: 30)
ASSET_BALANCE_POLL_INTERVAL_SECONDS=30
# TTL for the portfolio cache in seconds — keeps GET portfolio < 200ms (default: 5)
ASSET_PORTFOLIO_CACHE_SECONDS=5
# Spam asset filtering (configurable)
ASSET_SPAM_FILTER_ENABLED=true
# Hide credit assets that publish no SEP-1 metadata (default: false)
ASSET_SPAM_FILTER_UNLISTED=false
# Always-allowed assets — comma-separated "XLM" or "CODE:ISSUER"
# (USDC testnet issuer shown; replace with the mainnet issuer in production)
ASSET_SPAM_ALLOWLIST=XLM
# Always-filtered assets — comma-separated "CODE:ISSUER"
ASSET_SPAM_BLOCKLIST=
# Upper bound on balances reported before spam filtering trims the list (default: 500)
ASSET_MAX_BALANCES=500

# Contract IDs (deploy and fill after local deployment)
ESCROW_CONTRACT_ID=
# Escrow release reminder emails (notifications service)
ESCROW_REMINDERS_ENABLED=false
# ESCROW_REMINDER_SCAN_INTERVAL_MS=900000
# APP_BASE_URL=http://localhost:3000

# Escrow auto-release on delivery confirmation (never commit real secrets)
ESCROW_WEBHOOK_SECRET=

# --- Issue #369 — Automated Oracle Delivery Receipt Signing ---
# Provider backing the oracle Ed25519 signing key. One of: local | aws_kms | vault
ORACLE_KEY_PROVIDER=local
# Key id for the selected provider:
#   - local:  arbitrary id; a fresh keypair is generated when absent
#   - aws_kms: alias name, alias ARN, key ARN, or key ID
#   - vault:  transit key name (must be type=ed25519)
ORACLE_KEY_ID=
# AWS region for the KMS provider (defaults to AWS_REGION / us-east-1)
ORACLE_AWS_REGION=
# Vault Transit mount (default: transit)
ORACLE_VAULT_MOUNT=transit
# Address of the wallet/oracle caller that submits signed receipts on-chain
ORACLE_CALLER_ADDRESS=
ESCROW_AUTO_RELEASE_CALLER_ADDRESS=
# Carrier tracking webhooks — EasyPost / FedEx / UPS (Issue #291, never commit real secrets)
EASYPOST_WEBHOOK_SECRET=
# Optional fallback when a single secret fronts multiple carriers
CARRIER_WEBHOOK_SECRET=
# HMAC-SHA256 secrets for POST /api/v1/courier/webhooks/:carrier (Issue #577).
# Required per carrier; the route fails closed (401) when a secret is unset.
# CARRIER_WEBHOOK_SECRET above is NOT used by this route.
FEDEX_WEBHOOK_SECRET=
UPS_WEBHOOK_SECRET=
DHL_WEBHOOK_SECRET=
# Set false to disable the in-process carrier-tracking queue consumer
ENABLE_CARRIER_TRACKING_WORKER=true
REPUTATION_CONTRACT_ID=
PERMISSIONS_CONTRACT_ID=
MARKETPLACE_CONTRACT_ID=

# Partial refunds & dispute mediation (Issue #46)
DISPUTE_MEDIATOR_POOL=
DISPUTE_SLA_SCAN_INTERVAL_SECONDS=3600
ENABLE_DISPUTE_SLA_ESCALATION=true

# Recurring subscriptions with escrow (Issue #47)
SUBSCRIPTION_ESCROW_TIMEOUT_LEDGERS=17280
SUBSCRIPTION_BILLING_INTERVAL_SECONDS=3600
ENABLE_SUBSCRIPTION_BILLING=true

# --- Currency Conversion Rate Cache (Issue #379) ---
# TTL for the fresh rate copy in seconds (default: 300 = 5 minutes)
EXCHANGE_RATE_CACHE_TTL_SECONDS=300
# TTL for the last-known-good fallback copy in seconds (default: 86400 = 24h).
# This is what serves reads while the rate oracle is unreachable.
EXCHANGE_RATE_STALE_TTL_SECONDS=86400
# Background refresh cadence in seconds (default: 300; 0 disables the scheduler)
EXCHANGE_RATE_REFRESH_INTERVAL_SECONDS=300
# Comma-separated BASE/QUOTE pairs the scheduler keeps warm
EXCHANGE_RATE_PAIRS=USD/XLM,EUR/XLM,USD/BTC,USD/ETH,USD/USDC
# Sanity ceiling for oracle rates (default: 100000)
EXCHANGE_RATE_MAX_SANE_RATE=100000
# Circuit breaker for oracle calls (mirrors the other CIRCUIT_BREAKER_* knobs)
EXCHANGE_RATE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
EXCHANGE_RATE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_MS=30000
EXCHANGE_RATE_CIRCUIT_BREAKER_HALF_OPEN_SUCCESS=2
# Set false to skip the background refresh scheduler entirely
ENABLE_EXCHANGE_RATE_CACHE=true

# Gateway tiered token-bucket rate limiting (Issue #51)
INTERNAL_SERVICE_KEY=

# Wallet service (never commit real secrets)
WALLET_ACTIVE_KEY_VERSION=v1
WALLET_KEY_SIGNER_KEY_ID=
WALLET_KEY_SIGNER_PROVIDER=local
WALLET_MASTER_SECRET=
WALLET_MASTER_SECRET_V1=
WALLET_MASTER_SECRET_V2=
WALLET_SIGNER_SECRET=
AWS_REGION=us-east-1
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit

# --- Column-level encryption for PII at rest (Issue #68) ---
# Data-encryption-key provider. One of: local | aws_kms | vault
ENCRYPTION_KEY_PROVIDER=local
# Master secret(s) for the 'local' provider. Base ENCRYPTION_MASTER_KEY maps to
# key version 1; version N is supplied as ENCRYPTION_MASTER_KEY_V<N>. Rotating
# the key = adding ENCRYPTION_MASTER_KEY_V<N+1> and bumping
# ENCRYPTION_ACTIVE_KEY_VERSION, then running the re-encryption backfill.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_MASTER_KEY_V1=
ENCRYPTION_MASTER_KEY_V2=
ENCRYPTION_ACTIVE_KEY_VERSION=1
# 'local' provider will refuse to boot (and never fall back to a default
# secret) unless NODE_ENV is 'development'.
ENCRYPTION_REQUIRE_REAL_MASTER_KEY=false
# 'local' provider falls back to a hard-coded dev-only master secret when true.
ENCRYPTION_LOCAL_DEV_FALLBACK=true
# AWS KMS settings for the 'aws_kms' provider. The data key is enveloped via
# GenerateDataKey/Decrypt; only the wrapped copy is persisted.
# ENCRYPTION_KMS_KEY_ID=alias/delego-pii
# HashiCorp Vault Transit settings for the 'vault' provider (transit engine).
# ENCRYPTION_VAULT_KEY_ID=delego-pii-data-key

# --- AI Agents ---
# Provider to use: openai | anthropic | gemini (default: openai)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Text embedding model for product search (default: text-embedding-3-small)
EMBED_MODEL=text-embedding-3-small

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
PUSH_PROVIDER_KEY=

# --- E2E Encrypted Support Chat (Issue #378) ---
# Set false to disable the support-chat WebSocket server on this replica.
SUPPORT_CHAT_ENABLED=true
# TTL (seconds) for ephemeral chat logs and offline-message queues in Redis (default 86400 = 24h).
SUPPORT_CHAT_LOG_TTL_SECONDS=86400

# --- Email Retry and Dead-Letter Queue (DLQ) ---
# Maximum number of retry attempts for failed email dispatches (1-10, default: 3)
EMAIL_MAX_RETRIES=3

# Base delay in seconds for exponential backoff (default: 2)
# Retry delays: attempt N = 2^(N-1) * BASE_DELAY, max 120 seconds
EMAIL_RETRY_BASE_DELAY_SECONDS=2

# Enable Dead-Letter Queue logging for failed emails (true/false, default: true)
# Set to false to disable DLQ in test environments
EMAIL_DLQ_ENABLED=true

# SendGrid API key for sending emails
SENDGRID_API_KEY=

# From email address (default: noreply@delego.app)
FROM_EMAIL=noreply@delego.app

# --- Restock waitlist notifications (notifications service) ---
ENABLE_RESTOCK_WORKER=true
RESTOCK_BATCH_SIZE=50
# Email provider pacing for waitlist sends (token bucket)
RESTOCK_EMAIL_RATE_PER_SECOND=10
RESTOCK_EMAIL_BURST=10
RESTOCK_WORKER_CONCURRENCY=2
STOREFRONT_URL=https://delego.app

# --- Low-stock alerts ---
# Orchestrator: evaluate thresholds on inventory decrement
ENABLE_LOW_STOCK_ALERTS=true
# Suppress repeat alerts for the same item for this long (seconds)
LOW_STOCK_ALERT_DEBOUNCE_SECONDS=21600
# Notifications: webhook + email consumer
ENABLE_LOW_STOCK_WORKER=true
LOW_STOCK_WORKER_CONCURRENCY=5
MERCHANT_DASHBOARD_URL=https://merchant.delego.app

# --- Bulk catalog CSV import (gateway) ---
ENABLE_CATALOG_IMPORT_WORKER=true
CATALOG_IMPORT_CONCURRENCY=2
CATALOG_IMPORT_MAX_BYTES=209715200
CATALOG_IMPORT_MAX_ROWS=1000000

# --- Auth (placeholder) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Issuer / audience claims used when validating JWTs at the gateway.
JWT_ISSUER=delego-gateway
JWT_AUDIENCE=delego-clients
# Allowed clock skew (in seconds) when validating the `nbf` and `exp` JWT claims.
# Helps tolerate minor clock drift between distributed services. Default 5, max 300.
JWT_CLOCK_TOLERANCE_SECONDS=5

# --- OAuth2 Providers ---
# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Redirect URI for OAuth callbacks (must match provider configuration)
OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/callback

# --- Analytics ---
ANALYTICS_ENABLED=true

# --- Runtime Application Self-Protection (gateway, Issue #160) ---
RASP_ENABLED=true
RASP_MODE=block
RASP_SAMPLING_RATE=1
RASP_TRUSTED_PATHS=/health,/.well-known
RASP_TRUSTED_IPS=
# Optional JSON array of custom RASP rules
RASP_RULES=
# Optional SIEM ingestion webhook
RASP_SIEM_WEBHOOK_URL=

# --- XDR Payload Size Guard ---
# Maximum allowed size (in bytes) for a serialised TransactionRequest payload.
# MAX_XDR_BYTES=65536

# --- CDC escrow snapshot archiver (Issue #290) ---
# Set to false to run the CDC service without the nightly escrow archiver.
ESCROW_ARCHIVE_ENABLED=true
# Escrows settled more than this many days ago are archived (default: 90).
ESCROW_ARCHIVE_RETENTION_DAYS=90
# Rows moved per transaction (default: 500).
ESCROW_ARCHIVE_BATCH_SIZE=500
# Batches per nightly run; the rest of a backlog drains the following night (default: 20).
ESCROW_ARCHIVE_MAX_BATCHES=20
# UTC hour the nightly run fires at, 0-23 (default: 3).
ESCROW_ARCHIVE_HOUR_UTC=3
# Live escrow table and its identifying columns (defaults match the escrow schema).
ESCROW_ARCHIVE_SOURCE_TABLE=escrows
ESCROW_ARCHIVE_TABLE=escrow_archives
ESCROW_ARCHIVE_ID_COLUMN=id
ESCROW_ARCHIVE_ESCROW_ID_COLUMN=escrow_id
ESCROW_ARCHIVE_STATUS_COLUMN=status
ESCROW_ARCHIVE_CLOSED_AT_COLUMN=closed_at

# Fraud detection
FRAUD_DETECTION_URL=http://localhost:3013
FRAUD_ESCROW_VELOCITY_THRESHOLD=10

# --- Certificate Expiry Monitoring (certmanager, Issue #390) ---
# Run the background expiry checker (true/false, default: true)
CERT_EXPIRY_ENABLED=true
# Sweep interval in milliseconds (default: 12h)
CERT_EXPIRY_INTERVAL_MS=43200000
# Days before expiry at which an alert fires (default: 14)
CERT_EXPIRY_WARNING_DAYS=14
# JSON array of merchant domains to monitor: [{"merchantId":"m1","domain":"shop.example.com"}]
CERT_EXPIRY_DOMAINS=
# Optional webhook that receives POSTed expiry alerts (log sink is always on)
CERT_EXPIRY_WEBHOOK_URL=
# TLS port probed on merchant domains (default: 443)
CERT_EXPIRY_PROBE_PORT=443
# Per-probe connect timeout in milliseconds (default: 10000)
CERT_EXPIRY_PROBE_TIMEOUT_MS=10000

# Token bucket rate limiting for unauthenticated search APIs
# Maximum number of tokens (requests) available per client IP bucket
SEARCH_RATE_LIMIT_CAPACITY=60
# Token refill rate per second for each client IP bucket
SEARCH_RATE_LIMIT_REFILL_RATE_PER_SEC=1
# TTL (seconds) for idle rate limit buckets before they are evicted from Redis
SEARCH_RATE_LIMIT_BUCKET_TTL_SECONDS=120

# ── Soroban event ingestion (cdc) ───────────────────────────────────────────
# Comma-separated contract ids to ingest; the worker resumes each one from
# soroban_event_sync_checkpoints after a restart.
SOROBAN_CONTRACT_IDS=
# Ledger to start from when a contract has no checkpoint (e.g. its deploy
# ledger). Defaults to the RPC node's oldest retained ledger.
SOROBAN_INITIAL_LEDGER=
SOROBAN_LEDGER_WINDOW_SIZE=1000
SOROBAN_PAGE_SIZE=100
SOROBAN_POLL_INTERVAL_MS=5000

# ── Merchant SEP-1 domain verification (wallet) ─────────────────────────────
# UTC hour for the daily re-verification sweep.
MERCHANT_DOMAIN_REVERIFY_HOUR_UTC=3

# ── Guaranteed path payment quotes (wallet) ─────────────────────────────────
# Ed25519 secret (S...) of the quote oracle. Quoting is disabled when unset.
PATH_QUOTE_ORACLE_SECRET=
PATH_QUOTE_MAX_PRICE_IMPACT_PCT=2.5
